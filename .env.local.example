# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real keys.

# Supabase project URL. Find it in your Supabase dashboard:
# Project → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon (public) API key. Find it right next to the URL:
# Project → Project Settings → API Keys → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
